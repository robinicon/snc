# SNC MMORPG Server - Environment Configuration Template
# 复制此文件为 .env 并填入实际值后启动服务器
#
# 注意：.env 文件已加入 .gitignore，请勿提交真实密钥到仓库。

# ── 网络端口 ──────────────────────────────────────────────────────
# MasterService（服务注册/GM/Admin）
SNC_MASTER_PORT=23000
SNC_MASTER_ADMIN_PORT=9001

# GateServer（客户端连接入口）
SNC_GATE_PORT=23001

# AccountService（认证/注册）
SNC_ACCOUNT_PORT=23002

# GameServer（游戏逻辑，可由 CMake preset 自动分配）
SNC_GAME_PORT=23003

# ── 数据库 ────────────────────────────────────────────────────────
# MySQL（可选，需 SNC_ENABLE_MYSQL=ON）
SNC_DB_HOST=127.0.0.1
SNC_DB_PORT=3306
SNC_DB_USER=root
SNC_DB_PASSWORD=changeme
SNC_DB_NAME=snc_mmorpg

# Redis（可选，服务发现后端）
SNC_REDIS_HOST=127.0.0.1
SNC_REDIS_PORT=6379
SNC_REDIS_PASSWORD=

# ── 安全密钥 ─────────────────────────────────────────────────────
# JWT 签名密钥（必须 >= 32 字节）
SNC_JWT_SECRET=please-change-this-to-a-minimum-32-byte-secret!!!

# MMO 示例用密钥（example_game.cpp / example_full.cpp 中已使用安全的 40 字节密钥）
SNC_MMO_GAME_SECRET=legend-mmo-game-secret-key-2024-for-production-use-only!!
SNC_MMO_FULL_SECRET=legend-mmo-demo-secret-key-2024-local-environment-only!!

# ── 日志 ──────────────────────────────────────────────────────────
# 日志级别：TRACE / DEBUG / INFO / WARN / ERROR / CRITICAL
SNC_LOG_LEVEL=INFO

# ── 构建选项 ──────────────────────────────────────────────────────
# 以下为 CMake 构建选项，可在 cmake -D 参数中覆盖
# SNC_ENABLE_PROTOBUF=ON
# SNC_ENABLE_FLATBUFFERS=OFF
# SNC_ENABLE_MYSQL=OFF
# SNC_ENABLE_REDIS=OFF
